# ─── DepoFi Environment Variables ───────────────────────────────────────────
# Copy to .env and fill in your values.  NEVER commit .env to git.

# ── Deployer private keys (hex, no 0x prefix) ────────────────────────────────
PRIVATE_KEY_DEV=da146374a75310b9666e834ee4ad0866d6f4035967bfc76217c5a495fff9f0d0
PRIVATE_KEY_NILE=your_nile_private_key_here
PRIVATE_KEY_MAINNET=your_mainnet_private_key_here

# ── Network endpoints (override defaults if needed) ──────────────────────────
# TRON_FULL_NODE_NILE=https://nile.trongrid.io
# TRON_FULL_NODE_MAINNET=https://api.trongrid.io

# ── Deployed contract addresses (filled after migration) ─────────────────────
NEXT_PUBLIC_LOAN_FACTORY_ADDRESS=
NEXT_PUBLIC_DEPOFI_ROUTER_ADDRESS=

# Nile testnet USDT (test token – NOT real funds)
NEXT_PUBLIC_USDT_ADDRESS_NILE=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Mainnet USDT TRC20
NEXT_PUBLIC_USDT_ADDRESS_MAINNET=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=nile       # "nile" | "mainnet"
NEXT_PUBLIC_PASSCODE=admin25   # invite gate passcode
